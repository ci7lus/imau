{
  "name": "imau",
  "version": "1.0.0",
  "description": "Sync your viewing status from Annict to MAL/AniList.",
  "author": "ci7lus <7887955+ci7lus@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:ci7lus/imau.git"
  },
  "scripts": {
    "d": "netlify dev",
    "dev": "vite",
    "build": "vite build",
    "lint": "biome lint",
    "format": "biome format --fix",
    "check": "biome check",
    "typecheck": "tsc -b",
    "codegen": "concurrently -n codegen: 'pnpm:codegen:*'",
    "codegen:annict": "graphql-codegen --config ./annict-codegen.yml && pnpm format",
    "codegen:anilist": "graphql-codegen --config ./anilist-codegen.yml && pnpm format"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "netlify-cli": "^27.1.0",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "biome check"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@netlify/functions": "^5.3.0",
    "cookie": "^2.0.1",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-query": "^3.39.3",
    "tabler-icons-react": "^1.56.0"
  },
  "type": "module"
}
